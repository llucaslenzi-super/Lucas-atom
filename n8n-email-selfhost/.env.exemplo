# ============ Postgres ============
POSTGRES_USER=n8n
POSTGRES_PASSWORD=TROQUE_POR_UMA_SENHA_FORTE
POSTGRES_DB=n8n

# ============ n8n ============
# Gere com:  openssl rand -hex 32
# ATENCAO: essa chave abre TODAS as credenciais. Guarde num lugar seguro.
# Se perder, voce perde as credenciais salvas (SES etc).
N8N_ENCRYPTION_KEY=COLE_AQUI_A_CHAVE_DE_32_BYTES

# Dominio publico do n8n de marketing.
# Aponte esse subdominio no DNS pro IP da VM (registro A).
N8N_HOST=n8n-mkt.atomtecnologia.com
