# ============ Postgres ============
POSTGRES_USER=n8n
POSTGRES_PASSWORD=TROQUE_POR_UMA_SENHA_FORTE
POSTGRES_DB=n8n

# ============ n8n ============
# Gere com:  openssl rand -hex 32
N8N_ENCRYPTION_KEY=COLE_AQUI_A_CHAVE_DE_32_BYTES

# --- FASE 1: só testar envio (sem tracking/bounce) ---
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678/

# --- FASE 2: quando o túnel estiver no ar, comente as 2 linhas acima e use estas ---
# N8N_HOST=n8n-mkt.atomtecnologia.com
# WEBHOOK_URL=https://n8n-mkt.atomtecnologia.com/
