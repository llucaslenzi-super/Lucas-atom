# App DB role (RLS enforced, NOBYPASSRLS)
DATABASE_URL=postgresql+psycopg://atom_app@localhost:5432/atom
# Admin/owner DB role (runs migrations + seed; bypasses RLS)
ADMIN_DATABASE_URL=postgresql+psycopg://atom_owner@localhost:5432/atom

# Auth
JWT_SECRET=change-me-in-secret-manager
JWT_ALG=HS256
ACCESS_TTL_MIN=30
REFRESH_TTL_DAYS=14
